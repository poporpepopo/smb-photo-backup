<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the password ciphertext is bound to this device's Keystore
     key, and the "already uploaded" records only make sense next to this device's MediaStore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
